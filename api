function http_json(string $url,array $headers,?array $payload=null):array{$ch=curl_init($url);$opts=[CURLOPT_RETURNTRANSFER=>true,CURLOPT_TIMEOUT=>50,CURLOPT_CONNECTTIMEOUT=>15,CURLOPT_HTTPHEADER=>$headers,CURLOPT_SSL_VERIFYPEER=>true,CURLOPT_SSL_VERIFYHOST=>2];if($payload!==null){$opts[CURLOPT_POST]=true;$opts[CURLOPT_POSTFIELDS]=json_encode($payload,JSON_UNESCAPED_UNICODE|JSON_UNESCAPED_SLASHES);}curl_setopt_array($ch,$opts);$body=curl_exec($ch);$err=curl_error($ch);$code=(int)curl_getinfo($ch,CURLINFO_HTTP_CODE);curl_close($ch);if($body===false)throw new RuntimeException('خطای ارتباط: '.$err);$j=json_decode($body,true);if($code>=400)throw new RuntimeException(is_array($j)?($j['description']??$j['error']['message']??'خطای سرویس خارجی'):'خطای سرویس خارجی');if(!is_array($j))throw new RuntimeException('پاسخ نامعتبر از سرویس خارجی');return $j;}
function bale_call(array $c,string $method,array $fields):array{if(empty($c['bale_token']))throw new RuntimeException('توکن ربات بله تنظیم نشده است.');$url='https://tapi.bale.ai/bot'.rawurlencode($c['bale_token']).'/'.$method;return http_json($url,['Content-Type: application/json'],$fields);}
