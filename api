function user_dir(?string $uid=null):string{$id=$uid??current_uid();if(!preg_match('/^[a-f0-9]{32}$/',$id))throw new RuntimeException('شناسه کاربر معتبر نیست.');$d=dirname(__DIR__).'/private/users/'.$id;if(!is_dir($d))mkdir($d,0700,true);return $d;}
